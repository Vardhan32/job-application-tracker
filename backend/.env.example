# Copy this file to .env and adjust the values.

# MySQL connection string used by the app
DATABASE_URL=mysql+pymysql://tracker:tracker@localhost:3306/job_tracker?charset=utf8mb4

# Change both secrets before deploying anything
SECRET_KEY=replace-this-with-a-random-string
JWT_SECRET_KEY=replace-this-with-another-random-string
JWT_EXPIRES_HOURS=12

# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
